  m_Script: {fileID: 11500000, guid: 86fe9b1ed64eb2f459e3e1c7350d9250, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TapePlayer
  audioSource: {fileID: 0}
  tapeClip: {fileID: 8300000, guid: 9caa436a5583a914ebd01a50ed69cb9a, type: 3}
  subtitle: "\"hoje o dia \xE9 t\xE3o azul e quente... Fui pescar hoje mais cedo,
    e o rio estava infestado de peixe!\r\nA \xE1gua do rio estava cristalina, eu
    podia enxergar com clareza o cardume de peixes que viam em dire\xE7\xE3o \xE0
    isca. Trouxe uns 4kg que vai durar pra 1 semana, quem sabe eu vendo pra dona
    Maria... Sempre recebo tapetes de croch\xEA em troca.\"\r\n"
  subtitleTMP: {fileID: 1678763591}
  subtitleText: {fileID: 0}
  partDisplayDuration: 1.5
  charRevealDelay: 0.03
  clearOnStop: 1
